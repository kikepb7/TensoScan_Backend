# Copy to .env for local development. Never commit real values.
# Required
TENSOSCAN_MONGODB_URL=mongodb://tensoscan:change-me@localhost:27017/?authSource=admin
# At least 32 bytes. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TENSOSCAN_SECRET_KEY=
# Optional
TENSOSCAN_ENVIRONMENT=dev
TENSOSCAN_DB_NAME=tenso_scan_db
TENSOSCAN_ACCESS_TOKEN_TTL_MINUTES=30
TENSOSCAN_REFRESH_TOKEN_TTL_DAYS=30
TENSOSCAN_LOG_JSON=false
TENSOSCAN_DEFAULT_REPORT_TZ=Europe/Madrid
# Assistant (chatbot) provider
TENSOSCAN_ASSISTANT_PROVIDER_API_KEY=
TENSOSCAN_ASSISTANT_MODEL=gpt-4o-mini
# Legacy on-server OCR (needs the legacy-ocr extra). Disabled by default.
TENSOSCAN_ENABLE_LEGACY_OCR=false
TENSOSCAN_LEGACY_OCR_MODEL_PATH=ia_models/tensoscan_model.keras

# docker-compose (development)
MONGO_INITDB_ROOT_USERNAME=tensoscan
MONGO_INITDB_ROOT_PASSWORD=change-me
